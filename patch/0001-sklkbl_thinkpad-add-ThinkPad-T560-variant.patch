 	default "ThinkPad T480" if BOARD_LENOVO_T480
 	default "ThinkPad T480s" if BOARD_LENOVO_T480S
+	default "ThinkPad T560" if BOARD_LENOVO_T560
 	default "ThinkPad T580" if BOARD_LENOVO_T580
 	default "ThinkPad X280" if BOARD_LENOVO_X280
 	default "ThinkPad X380 Yoga" if BOARD_LENOVO_X380_YOGA
@@ -101,6 +108,7 @@ config DIMM_MAX
